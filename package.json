{
  "name": "core-api-tickets",
  "version": "1.0.0",
  "description": "Tickets microservice - ticket management and support operations",
  "main": "dist/server.js",
  "packageManager": "pnpm@9.1.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.1.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest --testPathPattern=test/unit --runInBand --forceExit",
    "test:integration": "jest --testPathPattern=test/integration --runInBand --forceExit",
    "test:coverage": "jest --coverage --runInBand --forceExit",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:run": "pnpm typeorm migration:run -d src/infrastructure/persistence/postgres/data-source.ts",
    "migration:revert": "pnpm typeorm migration:revert -d src/infrastructure/persistence/postgres/data-source.ts",
    "seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "cors": "2.8.5",
    "express": "4.21.2",
    "helmet": "7.1.0",
    "jsonwebtoken": "9.0.2",
    "pg": "8.12.0",
    "reflect-metadata": "0.2.2",
    "typeorm": "0.3.20",
    "uuid": "10.0.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.12",
    "@types/jsonwebtoken": "9.0.6",
    "@types/node": "20.16.0",
    "@types/supertest": "6.0.2",
    "@types/uuid": "10.0.0",
    "jest": "29.7.0",
    "pg-mem": "2.8.1",
    "supertest": "6.3.4",
    "ts-jest": "29.2.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.5.4"
  }
}
